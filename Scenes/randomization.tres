code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_lambert, specular_schlick_ggx;

uniform sampler2D tex_frg_2 : source_color;
uniform sampler2D tex_frg_6 : source_color;
uniform sampler2D tex_frg_11 : source_color;
uniform sampler2D tex_frg_17 : source_color;
uniform sampler2D tex_frg_25 : source_color;
uniform sampler2D tex_frg_26 : source_color;
uniform sampler2D tex_frg_27 : source_color;



void fragment() {
// Input:3
	vec2 n_out3p0 = UV;


// FloatConstant:5
	float n_out5p0 = 6.000000;


// UVFunc:4
	vec2 n_in4p2 = vec2(0.00000, 0.00000);
	vec2 n_out4p0 = (n_out3p0 - n_in4p2) * vec2(n_out5p0) + n_in4p2;


// Texture2D:2
	vec4 n_out2p0 = texture(tex_frg_2, n_out4p0);


// Input:9
	vec2 n_out9p0 = UV;


// FloatConstant:7
	float n_out7p0 = 4.000000;


// UVFunc:8
	vec2 n_in8p2 = vec2(0.00000, 0.00000);
	vec2 n_out8p0 = (n_out9p0 - n_in8p2) * vec2(n_out7p0) + n_in8p2;


// Texture2D:6
	vec4 n_out6p0 = texture(tex_frg_6, n_out8p0);


// Texture2D:11
	vec4 n_out11p0 = texture(tex_frg_11, UV);


// Mix:10
	vec3 n_out10p0 = mix(vec3(n_out2p0.xyz), vec3(n_out6p0.xyz), vec3(n_out11p0.xyz));


	vec3 n_out12p0;
// ColorFunc:12
	{
		vec3 c = n_out10p0;
		vec4 K = vec4(0.0, -1.0 / 3.0, 2.0 / 3.0, -1.0);
		vec4 p = mix(vec4(c.bg, K.wz), vec4(c.gb, K.xy), step(c.b, c.g));
		vec4 q = mix(vec4(p.xyw, c.r), vec4(c.r, p.yzx), step(p.x, c.r));
		float d = q.x - min(q.w, q.y);
		float e = 1.0e-10;
		n_out12p0 = vec3(abs(q.z + (q.w - q.y) / (6.0 * d + e)), d / (q.x + e), q.x);
	}


// VectorDecompose:13
	float n_out13p0 = n_out12p0.x;
	float n_out13p1 = n_out12p0.y;
	float n_out13p2 = n_out12p0.z;


// Texture2D:17
	vec4 n_out17p0 = texture(tex_frg_17, UV);


	float n_out18p0;
// Remap:18
	float n_in18p1 = 0.00000;
	float n_in18p2 = 1.00000;
	float n_in18p3 = 0.00000;
	float n_in18p4 = 0.30000;
	{
		float __input_range = n_in18p2 - n_in18p1;
		float __output_range = n_in18p4 - n_in18p3;
		n_out18p0 = n_in18p3 + __output_range * ((n_out17p0.x - n_in18p1) / __input_range);
	}


// FloatOp:16
	float n_out16p0 = n_out13p1 + n_out18p0;


// VectorCompose:14
	vec3 n_out14p0 = vec3(n_out13p0, n_out16p0, n_out13p2);


	vec3 n_out15p0;
// ColorFunc:15
	{
		vec3 c = n_out14p0;
		vec4 K = vec4(1.0, 2.0 / 3.0, 1.0 / 3.0, 3.0);
		vec3 p = abs(fract(c.xxx + K.xyz) * 6.0 - K.www);
		n_out15p0 = c.z * mix(K.xxx, clamp(p - K.xxx, 0.0, 1.0), c.y);
	}


// Input:19
	vec2 n_out19p0 = UV;


// FloatConstant:20
	float n_out20p0 = 6.000000;


// UVFunc:23
	vec2 n_in23p2 = vec2(0.00000, 0.00000);
	vec2 n_out23p0 = (n_out19p0 - n_in23p2) * vec2(n_out20p0) + n_in23p2;


// Texture2D:25
	vec4 n_out25p0 = texture(tex_frg_25, n_out23p0);


// Input:21
	vec2 n_out21p0 = UV;


// FloatConstant:22
	float n_out22p0 = 4.000000;


// UVFunc:24
	vec2 n_in24p2 = vec2(0.00000, 0.00000);
	vec2 n_out24p0 = (n_out21p0 - n_in24p2) * vec2(n_out22p0) + n_in24p2;


// Texture2D:26
	vec4 n_out26p0 = texture(tex_frg_26, n_out24p0);


// Texture2D:27
	vec4 n_out27p0 = texture(tex_frg_27, UV);


// Mix:28
	vec3 n_out28p0 = mix(vec3(n_out25p0.xyz), vec3(n_out26p0.xyz), vec3(n_out27p0.xyz));


// Output:0
	ALBEDO = n_out15p0;
	NORMAL_MAP = n_out28p0;


}
